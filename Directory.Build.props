<Project>
  <!--
    Shared build policy for every project in the repository.

    Previously this file only contained output-path overrides, which existed because the
    app and test projects shared the repository root as their project directory. Each
    project now owns its own directory, so those workarounds are no longer required.
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
