<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CoreCLR uses JIT-compiled code. This is required when Developer ID signing
       enables the hardened runtime; Native AOT builds would not need it. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
