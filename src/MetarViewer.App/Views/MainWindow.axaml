<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MetarViewer.ViewModels"
        xmlns:models="using:MetarViewer.Services"
        x:Class="MetarViewer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="METAR Viewer for Mac"
        Width="920" Height="780" MinWidth="680" MinHeight="600"
        Background="{DynamicResource SystemRegionBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Padding="24,18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="METAR Viewer" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Live aviation weather, translated" Opacity="0.65" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="{Binding ThemeToggleToolTip}" FontSize="20"
                Content="{Binding ThemeToggleGlyph}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24" Spacing="18" MaxWidth="820" HorizontalAlignment="Center">
        <Border Classes="card" Padding="20" CornerRadius="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="10">
            <TextBlock Text="Enter Airport" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                       Watermark="ICAO, IATA, or airport name" KeyDown="SearchBox_KeyDown"
                       TextChanged="SearchBox_TextChanged" />
              <Button Grid.Column="1" Command="{Binding FetchMetarCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="24" />
                  <TextBlock Text="Get METAR" />
                </StackPanel>
              </Button>
            </Grid>
            <ListBox ItemsSource="{Binding AirportSuggestions}" SelectionChanged="Suggestions_SelectionChanged"
                     IsVisible="{Binding HasSuggestions}" MaxHeight="160">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:AirportSuggestion">
                  <TextBlock Text="{Binding DisplayText}" Margin="6" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding HasError}" Background="#40E5484D" BorderBrush="#E5484D"
                BorderThickness="1" CornerRadius="8" Padding="14">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel IsVisible="{Binding HasCurrentMetar}" Spacing="18">
          <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding StationHeaderText}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ObservationTimeText}" Opacity="0.65" />
                </StackPanel>
                <Border Grid.Column="1" Background="#1677FF" CornerRadius="6" Padding="12,6" VerticalAlignment="Top">
                  <TextBlock Text="{Binding CurrentMetar.FlightCategory}" Foreground="White" FontWeight="Bold" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                <StackPanel><TextBlock Text="WIND" Opacity="0.6" FontSize="11"/><TextBlock Text="{Binding DecodedWind}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="VISIBILITY" Opacity="0.6" FontSize="11"/><TextBlock Text="{Binding DecodedVisibility}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="TEMPERATURE" Opacity="0.6" FontSize="11"/><TextBlock Text="{Binding DecodedTemperature}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="ALTIMETER" Opacity="0.6" FontSize="11"/><TextBlock Text="{Binding DecodedAltimeter}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="CLOUDS" Opacity="0.6" FontSize="11"/><TextBlock Text="{Binding DecodedClouds}" TextWrapping="Wrap"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10">
              <TextBlock Text="Raw METAR" FontSize="18" FontWeight="SemiBold" />
              <TextBox Text="{Binding CurrentMetar.RawMetar}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Menlo" />
            </StackPanel>
          </Border>

          <Border Padding="20" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
              <TextBlock Text="Decoded Information" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Flight Category" FontWeight="SemiBold"/><TextBlock Text="{Binding FlightCategoryDescription}" TextWrapping="Wrap" Opacity="0.75"/>
              <TextBlock Text="Weather" FontWeight="SemiBold"/><TextBlock Text="{Binding DecodedWeather}" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
