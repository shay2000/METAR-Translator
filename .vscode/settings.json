{
  "omnisharp.dotnetPath": "${workspaceFolder}/.dotnet",
  "dotnet.server.useOmnisharp": false,

  // Make plain `dotnet` in the integrated terminal resolve to the pinned SDK.
  // PATH is prepended rather than replaced so other tooling keeps working.
  "terminal.integrated.env.osx": {
    "DOTNET_ROOT": "${workspaceFolder}/.dotnet",
    "PATH": "${workspaceFolder}/.dotnet:${env:PATH}"
  },
  "terminal.integrated.env.linux": {
    "DOTNET_ROOT": "${workspaceFolder}/.dotnet",
    "PATH": "${workspaceFolder}/.dotnet:${env:PATH}"
  },

  // Keep the solution as the language server's entry point.
  "dotnet.defaultSolution": "MetarViewer.sln"
}
